# Copy to .env.local and fill in before running locally or deploying.

# ── STEM backend ──────────────────────────────────────────────────────────
# URL of the deployed STEM backend (no trailing slash).
NEXT_PUBLIC_API_BASE=https://your-stem-backend.vercel.app
# Optional: Vercel Deployment Protection bypass secret (if backend has SSO).
STEM_PROTECTION_BYPASS=

# ── App / session security ────────────────────────────────────────────────
# Public origin of THIS frontend, used to build OAuth redirect URIs.
# Leave unset to auto-detect from the request (works on Vercel previews).
APP_BASE_URL=https://your-stem-frontend.vercel.app
# 32+ random bytes (any encoding). Encrypts session cookies (AES-256-GCM).
# Generate: openssl rand -base64 48
AUTH_ENCRYPTION_KEY=
# Fallback signing/encryption secret if AUTH_ENCRYPTION_KEY is unset.
SESSION_SECRET=

# ── GitHub App OAuth ("Sign in with GitHub") — REQUIRED ──────────────────
# From your GitHub App settings: the App's OAuth client id + a generated
# client secret. Sign-in is impossible without these. Repo access is granted
# when the user INSTALLS the App, not via OAuth scopes. Set the App's
# "Callback URL" to: {APP_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# App slug from its public page github.com/apps/<slug> — used for the install
# link. Defaults to the deployed STEM App (stem-ci-andrew-kevin-007).
GITHUB_APP_SLUG=

# ── AWS account connection (cross-account IAM role) ───────────────────────
# STEM's control-plane AWS credentials, used to STS:AssumeRole into the
# customer's role and verify the connection. Region defaults to us-east-1.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# STEM's OWN AWS account id — the trusted principal in the customer's role.
# Optional: auto-derived from the credentials above (STS GetCallerIdentity).
STEM_AWS_ACCOUNT_ID=
# Dedicated secret used to derive each user's unique ExternalId
# (confused-deputy guard). Falls back to the session secret if unset.
STEM_AWS_EXTERNAL_ID_SECRET=

# ── Multi-tenant backend link ─────────────────────────────────────────────
# Shared secret the frontend presents when persisting a user's AWS+Aurora
# connection to the backend (/api/connections). MUST match the backend's
# STEM_INTERNAL_TOKEN. Required in production — without it the connection
# write path is rejected. Generate: openssl rand -hex 32
STEM_INTERNAL_TOKEN=
