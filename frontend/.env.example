# Copy to .env.local and fill in before running locally or deploying.

# URL of the deployed STEM backend (no trailing slash)
NEXT_PUBLIC_API_BASE=https://your-stem-backend.vercel.app

# Optional: Vercel Deployment Protection bypass secret (if backend has SSO enabled)
STEM_PROTECTION_BYPASS=

# Access key required at /login before the dashboard is reachable.
# Unset = the public demo key "stem-demo" is accepted (demo mode).
DASHBOARD_ACCESS_KEY=

# Secret used to HMAC-sign session cookies. Set a long random string in
# production; unset = derived from the access key (demo mode only).
SESSION_SECRET=
