# Copy to .env.local and fill in all values before running locally or deploying.

# AWS — control plane (STEM's own account; also the source for operator repos)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DSQL_ENDPOINT=                # Aurora DSQL cluster endpoint (no https://)

# Operator's own Aurora source cluster (used for STEM_OPERATOR_LOGIN's repos;
# tenants supply their own cluster details via the Connect page instead).
AURORA_SOURCE_CLUSTER_ID=     # Source Aurora PG cluster ID for COW clones
AURORA_SUBNET_GROUP=          # DB subnet group name for the clone
AURORA_SECURITY_GROUP_ID=     # VPC security group ID for the clone
AURORA_MASTER_USER=           # Master username for the operator's Aurora PG
AURORA_MASTER_PASSWORD=       # Master password

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=  # Single-line PEM with literal \n — store exactly as-is
GITHUB_WEBHOOK_SECRET=   # HMAC SHA256 webhook secret

# Vercel
VERCEL_TOKEN=            # Personal access token with project read/write scope
VERCEL_PROJECT_ID=       # Project ID of the stem-app backend Vercel project
STEM_BASE_URL=           # Full URL of this deployed backend e.g. https://stem-app-xxx.vercel.app

# Multi-tenant
STEM_INTERNAL_TOKEN=     # Shared secret for the frontend → /api/connections write path.
                         # MUST match the frontend's STEM_INTERNAL_TOKEN. openssl rand -hex 32
STEM_OPERATOR_LOGIN=Andrew-Kevin-007  # GitHub login whose repos use the env-configured
                         # cluster below (skips the per-tenant AssumeRole path)
STEM_TENANT_DB_SECRET=   # Secret to derive per-clone master passwords (clones reset before
                         # anonymizing). Falls back to GITHUB_WEBHOOK_SECRET if unset.
STEM_TEAM_ID=            # Optional. DSQL team_id for branch rows. Defaults to the
                         # all-zeros UUID if unset.
