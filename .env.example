# Copy to .env.local and fill in all values before running locally or deploying.

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
DSQL_ENDPOINT=           # Aurora DSQL cluster endpoint (no https://)
AURORA_SOURCE_CLUSTER=stem-source-prod-demo   # Source cluster ID for COW clones
AURORA_MASTER_USER=      # Master username for Aurora PG
AURORA_MASTER_PASSWORD=  # Master password

# GitHub App
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=  # Single-line PEM with literal \n — store exactly as-is
GITHUB_WEBHOOK_SECRET=   # HMAC SHA256 webhook secret

# Vercel
VERCEL_TOKEN=            # Personal access token with project read/write scope
VERCEL_PROJECT_ID=       # Project ID of the stem-app backend Vercel project
STEM_BASE_URL=           # Full URL of this deployed backend e.g. https://stem-app-xxx.vercel.app
